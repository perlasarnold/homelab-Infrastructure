# Terraform state
.terraform/
.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/proxmox/.terraform/
terraform/proxmox/.terraform.lock.hcl
terraform/.terraform/
terraform/.terraform.lock.hcl
*.tfplan

# Variable files with secrets — NEVER commit these
terraform/terraform.tfvars
terraform/proxmox/terraform.tfvars
*.tfvars
!*.tfvars.example

# SOPS — only .enc files are committed; plaintext .env files are NOT
secrets/*.env
!secrets/*.env.example
!secrets/*.env.enc

# Ansible runtime inventory (generated by workflows)
ansible/inventory_ci.yml

# Installer build artifacts
installer/dist/
installer/build/
installer/__pycache__/
*.spec

# MkDocs built site (published via gh-deploy, not committed)
site/

# WinRM cert generated by setup script
setup/winrm_cacert.pem
setup/winrm_cacert.cer

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
*.suo
*.user

# Notebooks
notebooks/.ipynb_checkpoints/

# Runtime temp files
/tmp/homelab_key
/tmp/inventory_ci.yml
