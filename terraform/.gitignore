# Terraform — ignore secrets and local state
terraform.tfvars
*.tfvars
!*.tfvars.example

# Terraform working directories
**/.terraform/
**/.terraform.lock.hcl

# State files (use remote backend in production)
*.tfstate
*.tfstate.backup
*.tfstate.d/

# Crash logs
crash.log

# Override files
override.tf
override.tf.json

# Sensitive output files
*.tfplan
